## Terraform
# Local Terraform directories
.terraform/
.terraform.d/

# Terraform state files
*.tfstate
*.tfstate.backup
*.tfstate.*

# Crash log files
crash.log

# Exclude .tfvars containing sensitive data (uncomment if you use tfvars files locally)
# *.tfvars
# *.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc

# NOTE: keep the lock file committed to track provider checksums
# Do NOT ignore: .terraform.lock.hcl
